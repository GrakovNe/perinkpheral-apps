{
  "name": "status",
  "title": "Service status",
  "author": "Perinkpheral",
  "description": "Status of popular services",
  "version": "0.2.2",
  "abi": 3,
  "fullscreen": false,
  "icon": [
    "...........",
    "....###....",
    "...#...#...",
    "..#.....#..",
    "..#..#..#..",
    "..#..#..#..",
    "..#.....#..",
    "...#...#...",
    "....###....",
    "...........",
    "..........."
  ],
  "settings": [
    {
      "key": "services",
      "type": "list",
      "title": "Services",
      "help": "Status page host: www.githubstatus.com",
      "default": [
        "www.githubstatus.com",
        "discordstatus.com",
        "status.openai.com"
      ]
    },
    {
      "key": "pace",
      "type": "choice",
      "title": "Refresh",
      "options": [
        "1 min",
        "5 min",
        "15 min",
        "30 min"
      ],
      "default": "5 min"
    }
  ],
  "polls": [
    {
      "url": "https://{{services}}/api/v2/status.json",
      "every": "{{pace}}",
      "each": "services",
      "pick": [
        "page.name",
        "status.indicator"
      ]
    }
  ],
  "firmware": "0.1.30"
}
