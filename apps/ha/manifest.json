{
  "name": "ha",
  "version": "0.3.16",
  "title": "HA Companion",
  "author": "Perinkpheral",
  "description": "Home Assistant dashboard.",
  "abi": 3,
  "settings": [
    { "key": "server", "type": "url", "title": "Server", "hidden": true },
    { "key": "token", "type": "secret", "title": "Access token", "hidden": true },
    { "key": "every", "type": "choice", "title": "Refresh",
      "options": ["1 min", "5 min", "15 min", "1 h"], "default": "5 min" }
  ],
  "hosts": ["{{server}}"],
  "intents": ["started"],
  "icon": [
    ".....#.....",
    "....###....",
    "...#####...",
    "..#######..",
    ".#########.",
    "###########",
    ".##.....##.",
    ".##.###.##.",
    ".##.###.##.",
    ".##.###.##.",
    ".#########."
  ]
}
