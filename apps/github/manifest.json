{
  "name": "github",
  "title": "GitHub activity",
  "author": "Perinkpheral",
  "description": "Activity calendar",
  "version": "0.1.3",
  "abi": 3,
  "fullscreen": false,
  "icon": [
    "...........",
    ".##.....##.",
    ".#.#####.#.",
    ".#.......#.",
    "#..#...#..#",
    "#.........#",
    ".#.......#.",
    "..#######..",
    "....#.#....",
    "...##.##...",
    "..........."
  ],
  "hosts": [
    "api.github.com"
  ],
  "intents": [
    "started",
    "network_up",
    "time_changed"
  ],
  "settings": [
    {
      "key": "login",
      "type": "text",
      "title": "Login"
    },
    {
      "key": "token",
      "type": "secret",
      "title": "Read-only token"
    }
  ]
}
